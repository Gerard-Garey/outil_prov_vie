# NAMESPACE écrit à la main (ADR 0006, point 5 ; ADR 0010, point 13) : un export() par
# ligne, sans exportPattern. Le module `outils` est interne, les tests l'atteignent par
# provie::: (ADR 0010, point 1).
# Module `dictionnaire` (#18) : dictionnaire() et controler_types(), appelés hors du package
# par l'application (contrôle d'une feuille lue en data.frame avant le calcul, ADR 0010,
# point 2) et par l'utilisateur sans Shiny.
export(dictionnaire)
export(controler_types)
# Module `lecture` (#18) : lire_base() et ecrire_base(), appelés hors du package par
# l'utilisateur sans Shiny (lecture d'une base CSV en liste de data.frame à passer au moteur,
# qui ne reçoit jamais un fichier ; écriture d'une base construite à la main) et par les
# tests (aller-retour) (ADR 0010, points 2 et 13).
export(lire_base)
export(ecrire_base)
# Module `donnees` (#18) : controler_base(), appelée hors du package par l'application (bilan de
# la base à l'arrêté avant le calcul, onglet Données) et par l'utilisateur sans Shiny ; puis,
# en B2, par l'orchestration (ADR 0010, points 9 et 13 ; M147, M153).
# Bilan partiel par report déclaré (#18 fermée avec ce report, #34 ; M181) : les contrôles
# prévus et reportés figurent dans controles_non_executes, cause non_implemente
# (CONTROLES_NON_IMPLEMENTES).
export(controler_base)
# Module `lecture` (#19) : lire_jeu() et ecrire_jeu(), appelés hors du package par les tests
# (reproductibilité des jeux versionnés), par la session qui écrit un jeu versionné (commit
# donnees:) et par l'utilisateur sans Shiny (relecture d'un jeu sous inst/extdata/jeux/)
# (ADR 0010, points 13, 19 et 20).
export(lire_jeu)
export(ecrire_jeu)
# Module `simulation` (#19) : simuler_base(), appelée hors du package par les tests et par la
# session qui tire un jeu versionné ; hors de la chaîne du moteur (ADR 0010, points 1, 13 et 19).
export(simuler_base)
# Méthodes de la classe jeu_simule (ADR 0010, point 13) : décomptes seuls.
S3method(format, jeu_simule)
S3method(print, jeu_simule)
# Module `garanties` (#64) : catalogue_garanties(), appelée hors du package par l'application
# (onglet Plan : garanties, postes et méthodes proposés à la saisie du plan) et par
# l'utilisateur sans Shiny (lecture du catalogue avant d'écrire un plan) (ADR 0010, points 13
# et 16 ; spécification de B2, § 2.9).
export(catalogue_garanties)
# Module `plan` (#64) : valider_plan(), canoniser_plan(), ecrire_plan() et lire_plan(),
# appelées hors du package par l'application (onglet Plan : validation, export, import) et par
# l'utilisateur sans Shiny (plan écrit, contrôlé et relu sans calcul) ; ecrire_fiche() et
# lire_fiche(), par l'application (onglet Rapport : fiche) et par l'utilisateur sans Shiny
# (fiche écrite et relue pour le rejeu) (ADR 0007, point 5 ; ADR 0010, point 13 ;
# spécification de B2, § 2.9).
export(valider_plan)
export(canoniser_plan)
export(ecrire_plan)
export(lire_plan)
export(ecrire_fiche)
export(lire_fiche)
# Méthodes des classes plan_calcul et fiche_calcul (ADR 0010, point 13) : décomptes seuls.
S3method(format, plan_calcul)
S3method(print, plan_calcul)
S3method(format, fiche_calcul)
S3method(print, fiche_calcul)
